# Créer le bot auprès de @BotFather. Ne jamais committer le vrai token.
TELEGRAM_BOT_TOKEN=
# Votre identifiant NUMÉRIQUE Telegram (pas le pseudo). Séparer plusieurs IDs par des virgules.
TELEGRAM_ALLOWED_USER_IDS=
# Origine HTTPS sans chemin : domaine personnel ou adresse du tunnel temporaire.
PUBLIC_URL=https://vintedbot.example.com
DOMAIN=vintedbot.example.com
# Activer uniquement après vérification et autorisation de l'accès à Vinted.
VINTED_COLLECTION_ENABLED=false
VINTED_ACCESS_AUTHORIZED=false
# Espacement minimal global, pas la fréquence de chaque filtre (15 s par défaut).
# Augmenter selon les limites d'accès convenues. Ne garantit pas l'absence de blocage.
GLOBAL_REQUEST_GAP_SECONDS=1
DATABASE_PATH=/data/vintedbot.db
# Optionnel : proxy HTTP avec tunnel CONNECT pour les requêtes HTTPS Vinted uniquement.
# Renseigner via python3 -m app.configure_proxy ; ne jamais partager cette valeur.
VINTED_PROXY_URL=
# Taille de la fenêtre des nouveautés. 24 réduit fortement le trafic par rapport à 96.
VINTED_RESULTS_PER_POLL=24
# Après une interruption longue, refaire une référence silencieuse sans rattrapage historique.
VINTED_REBASE_AFTER_SECONDS=120
# Ne jamais envoyer individuellement une alerte devenue trop ancienne.
ALERT_MAX_AGE_SECONDS=120
